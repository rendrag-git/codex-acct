#!/usr/bin/env bash
# codex-acct-watch — poll ~/.codex/auth.json and mirror it into the active
# slot whenever it changes. Pure bash, portable across Linux + macOS.
set -euo pipefail

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
AUTH="$CODEX_DIR/auth.json"
INTERVAL="${CODEX_ACCT_WATCH_INTERVAL:-3}"

get_mtime() {
  # GNU stat first, fall back to BSD stat (macOS).
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}

last=0
while :; do
  if [[ -f "$AUTH" ]]; then
    cur=$(get_mtime "$AUTH")
    if [[ "$cur" != "$last" ]]; then
      codex-acct sync >/dev/null 2>&1 || true
      last="$cur"
    fi
  fi
  sleep "$INTERVAL"
done
