#!/usr/bin/env bash
# codex-acct — switch between Codex (ChatGPT) accounts by swapping ~/.codex/auth.json
set -euo pipefail

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
AUTH="$CODEX_DIR/auth.json"
CONFIG="$CODEX_DIR/config.toml"
ACCTS="$CODEX_DIR/accounts"
PROVIDERS="$CODEX_DIR/providers"
PRIMARY_FILE="$ACCTS/.primary"
ACTIVE_FILE="$ACCTS/.active"
ACTIVE_PROVIDER_FILE="$PROVIDERS/.active"
PREV_NAME="_previous"
ODIN_ENV_FILE_DEFAULT="$HOME/projects/odin/.env.1password"
CODEX_WRAPPER="${CODEX_ACCT_CODEX_WRAPPER:-$HOME/.local/bin/codex}"
CODEX_REAL="${CODEX_ACCT_REAL_CODEX:-$HOME/.local/bin/codex.codex-acct-real}"
LOCK_DIR="$CODEX_DIR/.codex-acct.lock"
DAEMON_SOCK="$CODEX_DIR/app-server-control/app-server-control.sock"
LOCK_HELD=0
SYNCED_SLOT=""
SYNC_NOTE=""

mkdir -p "$ACCTS"
chmod 700 "$ACCTS"
mkdir -p "$PROVIDERS"
chmod 700 "$PROVIDERS"

die() { echo "error: $*" >&2; exit 1; }

shell_quote() {
  printf '%q' "$1"
}

script_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "${BASH_SOURCE[0]}"
  else
    python3 - "${BASH_SOURCE[0]}" <<'PY'
import os
import sys

print(os.path.abspath(sys.argv[1]))
PY
  fi
}

is_managed_codex_wrapper() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  head -5 "$path" 2>/dev/null | grep -qx '# codex-acct managed wrapper'
}

real_codex_bin() {
  if [[ -n "${CODEX_ACCT_REAL_CODEX:-}" ]]; then
    [[ -x "$CODEX_ACCT_REAL_CODEX" ]] || die "CODEX_ACCT_REAL_CODEX is not executable: $CODEX_ACCT_REAL_CODEX"
    echo "$CODEX_ACCT_REAL_CODEX"
    return 0
  fi

  local candidate
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if is_managed_codex_wrapper "$candidate"; then
      continue
    fi
    [[ -x "$candidate" ]] || continue
    echo "$candidate"
    return 0
  done < <(type -aP codex 2>/dev/null | awk '!seen[$0]++')

  if [[ -x "$CODEX_REAL" ]]; then
    echo "$CODEX_REAL"
    return 0
  fi

  die "real codex binary not found on PATH"
}

release_lock() {
  if [[ "$LOCK_HELD" == "1" ]]; then
    rm -rf "$LOCK_DIR"
    LOCK_HELD=0
  fi
}

acquire_lock() {
  local tries=0 max_tries="${CODEX_ACCT_LOCK_TRIES:-300}"
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if [[ -f "$LOCK_DIR/pid" ]]; then
      local pid; pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
      if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
        rm -rf "$LOCK_DIR"
        continue
      fi
    fi
    (( tries += 1 ))
    if (( tries >= max_tries )); then
      die "timed out waiting for account lock: $LOCK_DIR"
    fi
    sleep 0.1
  done
  LOCK_HELD=1
  echo "$$" > "$LOCK_DIR/pid"
  chmod 700 "$LOCK_DIR"
  trap release_lock EXIT INT TERM
}

with_lock() {
  acquire_lock
  local rc=0
  "$@" || rc=$?
  release_lock
  trap - EXIT INT TERM
  return "$rc"
}

daemon_running() {
  [[ -S "$DAEMON_SOCK" ]] || return 1
  # Socket file can outlive the daemon — confirm via a control RPC.
  # Use the real codex binary directly (not the managed 'codex' shim): restart_daemon
  # runs while the codex-acct switch lock is held, and going through the shim would
  # re-enter codex-acct (cmd_run_codex -> with_lock) and deadlock on that same lock.
  "$(real_codex_bin)" app-server daemon version >/dev/null 2>&1
}

daemon_listener_pid() {
  # PID holding the listening end of the control socket.
  local pid
  pid=$(ss -xpl 2>/dev/null | grep -F "$DAEMON_SOCK" | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)
  if [[ -z "$pid" ]]; then
    # Fallback: pgrep the daemon argv (Rust binary, not the proxy shim).
    pid=$(pgrep -f 'codex app-server --listen unix://' | head -1)
  fi
  echo "$pid"
}

# Load the environment the fresh daemon must carry for the *currently configured*
# provider. Every switch path writes config.toml to the target provider before calling
# restart_daemon, so we key off config_provider() here. Odin needs ODIN_GATEWAY_TOKEN in
# the daemon's own environment — it is read at request time in the daemon process
# (model-provider-info/src/lib.rs), NOT in the TUI client — so exporting it into the
# launching shell only helps if the daemon we spawn inherits it. ChatGPT/OpenAI needs the
# var absent so a stale token never leaks into an OpenAI-backed daemon.
set_daemon_env_for_active_provider() {
  if [[ "$(config_provider)" == "odin" ]]; then
    load_odin_env_for_child
  else
    unset ODIN_GATEWAY_TOKEN ODIN_GATEWAY_BASE_URL ODIN_GATEWAY_MODEL 2>/dev/null || true
  fi
}

# Stop the current daemon listener (and its immediate parent) and drop the stale socket.
stop_daemon() {
  local listener_pid parent_pid waited=0
  listener_pid=$(daemon_listener_pid)
  if [[ -n "$listener_pid" ]]; then
    parent_pid=$(ps -o ppid= -p "$listener_pid" 2>/dev/null | tr -d ' ')
    [[ -n "$parent_pid" && "$parent_pid" != "1" ]] && kill "$parent_pid" 2>/dev/null || true
    kill "$listener_pid" 2>/dev/null || true
    while kill -0 "$listener_pid" 2>/dev/null && (( waited < 50 )); do
      sleep 0.1
      waited=$((waited + 1))
    done
  fi
  # Sweep any lingering listener bound to our socket, then remove the stale socket file.
  pkill -f "app-server --listen unix://$DAEMON_SOCK" 2>/dev/null || true
  [[ -S "$DAEMON_SOCK" ]] && rm -f "$DAEMON_SOCK"
  return 0
}

# Spawn a fresh, detached app-server listener that inherits the current environment.
# We deliberately bypass `codex app-server daemon start` (the "managed" path): it needs a
# standalone install that isn't present here, and where it does exist it restarts via an
# RPC to the *running* daemon, so the new process would inherit the OLD daemon's env
# instead of the token we just exported. A direct `--listen` spawn is exactly how an
# unmanaged daemon already runs, and it inherits this shell's env at fork.
spawn_daemon() {
  local codex_bin waited=0
  codex_bin=$(real_codex_bin) || return 1
  mkdir -p "$(dirname "$DAEMON_SOCK")"
  setsid "$codex_bin" app-server --listen "unix://$DAEMON_SOCK" \
    >>"$(dirname "$DAEMON_SOCK")/app-server.log" 2>&1 </dev/null &
  disown 2>/dev/null || true
  while ! daemon_running && (( waited < 25 )); do
    sleep 0.4
    waited=$((waited + 1))
  done
  daemon_running
}

restart_daemon() {
  local provider
  provider=$(config_provider)
  echo "restarting codex app-server daemon (provider=$provider)..."
  # Order matters: config.toml is already on the target provider, so resolve the daemon
  # env for it, tear the old daemon down, then bring up a replacement carrying that env.
  set_daemon_env_for_active_provider
  # Test seam: when an override manager is provided, delegate the real process lifecycle
  # to it (so the suite can assert intent — which provider, whether a token was resolved —
  # without spawning a real app-server) and skip the live kill/spawn.
  if [[ -n "${CODEX_ACCT_DAEMON_MANAGER:-}" ]]; then
    "$CODEX_ACCT_DAEMON_MANAGER" "$provider" "${ODIN_GATEWAY_TOKEN:-}"
    return $?
  fi
  stop_daemon
  if spawn_daemon; then
    echo "daemon restarted."
  else
    echo "warning: daemon did not come back up — start it manually so codex can (re)authenticate." >&2
  fi
}

slot_path() {
  local name="$1"
  echo "$ACCTS/$name.json"
}

write_active_name() {
  local name="$1"
  echo -n "$name" > "$ACTIVE_FILE"
  chmod 600 "$ACTIVE_FILE"
}

copy_auth_atomic() {
  local src="$1"
  local dest="$2"
  local tmp
  tmp=$(mktemp "$CODEX_DIR/.auth.XXXXXX")
  cp "$src" "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$dest"
}

save_previous_snapshot() {
  [[ -f "$AUTH" ]] || return 0
  copy_auth_atomic "$AUTH" "$(slot_path "$PREV_NAME")"
}

sync_active_slot() {
  SYNCED_SLOT=""
  SYNC_NOTE=""
  [[ -f "$AUTH" ]] || return 0
  local live_sub active dest match matches_count
  live_sub=$(auth_sub "$AUTH" || true)
  if [[ -z "$live_sub" ]]; then
    SYNC_NOTE="auth.json has no decodable identity; not syncing"
    return 0
  fi

  active=$(active_name)
  if [[ -n "$active" ]]; then
    dest=$(slot_path "$active")
    if [[ -f "$dest" ]]; then
      if auth_matches "$AUTH" "$dest"; then
        copy_auth_atomic "$AUTH" "$dest"
        SYNCED_SLOT="$active"
        return 0
      fi
    fi
  fi

  match=""
  matches_count=0
  shopt -s nullglob
  for dest in "$ACCTS"/*.json; do
    local name
    name=$(basename "$dest" .json)
    [[ "$name" == "$PREV_NAME" ]] && continue
    if auth_matches "$AUTH" "$dest"; then
      match="$name"
      (( matches_count++ ))
    fi
  done

  if (( matches_count == 1 )); then
    copy_auth_atomic "$AUTH" "$(slot_path "$match")"
    write_active_name "$match"
    SYNCED_SLOT="$match"
  elif (( matches_count > 1 )); then
    SYNC_NOTE="multiple saved slots match live auth; not guessing"
  else
    SYNC_NOTE="no saved slot matches live auth; not syncing"
  fi
}

# Decode the JWT id_token from a given auth.json path. Prints TAB-separated: email<TAB>plan<TAB>sub<TAB>account_id
decode_auth() {
  local file="$1"
  [[ -f "$file" ]] || { printf '\t\t\t\n'; return; }
  python3 - "$file" <<'PY'
import json, sys, base64
try:
    d = json.load(open(sys.argv[1]))
    tok = d["tokens"]["id_token"]
    payload = tok.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    p = json.loads(base64.urlsafe_b64decode(payload))
    email = p.get("email", "")
    plan = p.get("https://api.openai.com/auth", {}).get("chatgpt_plan_type", "")
    sub = p.get("sub", "")
    acct = d.get("tokens", {}).get("account_id", "")
    print(f"{email}\t{plan}\t{sub}\t{acct}")
except Exception as e:
    print(f"\t\t\t  ({e})")
PY
}

current_sub() { decode_auth "$AUTH" | cut -f3; }
auth_sub() {
  local file="$1"
  local email plan sub acct
  IFS=$'\t' read -r email plan sub acct < <(decode_auth "$file")
  [[ -n "$sub" ]] || return 1
  printf '%s\n' "$sub"
}
auth_matches() {
  local left="$1" right="$2"
  local left_email left_plan left_sub left_acct
  local right_email right_plan right_sub right_acct
  IFS=$'\t' read -r left_email left_plan left_sub left_acct < <(decode_auth "$left")
  IFS=$'\t' read -r right_email right_plan right_sub right_acct < <(decode_auth "$right")
  [[ -n "$left_sub" && "$left_sub" == "$right_sub" ]] || return 1
  if [[ -n "$left_acct" && -n "$right_acct" && "$left_acct" != "$right_acct" ]]; then
    return 1
  fi
}
active_name() { [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || echo ""; }
primary_name() { [[ -f "$PRIMARY_FILE" ]] && cat "$PRIMARY_FILE" || echo ""; }
active_provider_name() { [[ -f "$ACTIVE_PROVIDER_FILE" ]] && cat "$ACTIVE_PROVIDER_FILE" || echo ""; }

reserved_provider_name() {
  [[ "${1:-}" == "odin" ]]
}

odin_env_file() {
  if [[ -n "${CODEX_ACCT_ODIN_ENV_FILE:-}" ]]; then
    echo "$CODEX_ACCT_ODIN_ENV_FILE"
  elif [[ -f "$ODIN_ENV_FILE_DEFAULT" ]]; then
    echo "$ODIN_ENV_FILE_DEFAULT"
  fi
}

require_op_for_odin_env() {
  command -v op >/dev/null 2>&1 || die "op CLI is required to load Odin env file; set ODIN_GATEWAY_BASE_URL and ODIN_GATEWAY_TOKEN directly or install op"
}

read_odin_env_values() {
  local env_file
  env_file=$(odin_env_file)
  [[ -n "$env_file" ]] || return 1
  [[ -f "$env_file" ]] || die "Odin env file not found: $env_file"
  local file_values file_base_url file_model file_token base_url model token
  file_values=$(python3 - "$env_file" <<'PY'
import shlex
import sys
from pathlib import Path

keys = ("ODIN_GATEWAY_BASE_URL", "ODIN_GATEWAY_MODEL", "ODIN_GATEWAY_TOKEN")
values = {}
for raw in Path(sys.argv[1]).read_text().splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("export "):
        line = line[len("export "):].lstrip()
    if "=" not in line:
        continue
    key, value = line.split("=", 1)
    key = key.strip()
    if key not in keys:
        continue
    value = value.strip()
    if value[:1] in {"'", '"'}:
        try:
            parts = shlex.split(value, posix=True)
            value = parts[0] if parts else ""
        except ValueError:
            value = value.strip("'\"")
    else:
        value = value.split(" #", 1)[0].strip()
    values[key] = value
print("\t".join(values.get(key, "") for key in keys))
PY
)
  IFS=$'\t' read -r file_base_url file_model file_token <<< "$file_values"
  base_url=$(resolve_odin_env_value "ODIN_GATEWAY_BASE_URL" "${ODIN_GATEWAY_BASE_URL:-${file_base_url:-}}") || return $?
  model=$(resolve_odin_env_value "ODIN_GATEWAY_MODEL" "${ODIN_GATEWAY_MODEL:-${file_model:-}}") || return $?
  token=$(resolve_odin_env_value "ODIN_GATEWAY_TOKEN" "${ODIN_GATEWAY_TOKEN:-${file_token:-}}") || return $?
  printf "%s\t%s\t%s\n" "$base_url" "$model" "$token"
}

resolve_odin_env_value() {
  local name="$1" value="$2"
  if [[ "$value" == op://* ]]; then
    require_op_for_odin_env
    op read "$value" || die "failed to resolve $name from 1Password ref"
    return 0
  fi
  printf "%s\n" "$value"
}

read_odin_env_defaults() {
  local values base_url model _token
  values=$(read_odin_env_values) || return 1
  IFS=$'\t' read -r base_url model _token <<< "$values"
  printf "%s\t%s\n" "$base_url" "$model"
}

load_odin_env_for_child() {
  [[ -n "${ODIN_GATEWAY_TOKEN:-}" ]] && return 0
  local env_file values base_url model token
  env_file=$(odin_env_file)
  [[ -n "$env_file" ]] || die "Odin is active but ODIN_GATEWAY_TOKEN is not set and no Odin env file was found"
  [[ -f "$env_file" ]] || die "Odin env file not found: $env_file"
  values=$(read_odin_env_values) || die "failed to load Odin env file: $env_file"
  IFS=$'\t' read -r base_url model token <<< "$values"
  [[ -n "$token" ]] || die "Odin env file did not provide ODIN_GATEWAY_TOKEN: $env_file"
  export ODIN_GATEWAY_TOKEN="$token"
  [[ -n "$base_url" && -z "${ODIN_GATEWAY_BASE_URL:-}" ]] && export ODIN_GATEWAY_BASE_URL="$base_url"
  [[ -n "$model" && -z "${ODIN_GATEWAY_MODEL:-}" ]] && export ODIN_GATEWAY_MODEL="$model"
}

config_provider() {
  python3 - "$CONFIG" <<'PY'
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    print("openai")
    sys.exit(0)

path = Path(sys.argv[1])
if not path.exists():
    print("openai")
    sys.exit(0)
try:
    data = tomllib.loads(path.read_text())
except Exception:
    print("openai")
    sys.exit(0)
print(data.get("model_provider") or "openai")
PY
}

config_model() {
  python3 - "$CONFIG" <<'PY'
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    print("gpt-5.5")
    sys.exit(0)

path = Path(sys.argv[1])
if not path.exists():
