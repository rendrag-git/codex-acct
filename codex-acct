}

write_active_provider_name() {
  local name="$1"
  echo -n "$name" > "$ACTIVE_PROVIDER_FILE"
  chmod 600 "$ACTIVE_PROVIDER_FILE"
}

current_odin_base_url() {
  python3 - "$CONFIG" <<'PY'
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    sys.exit(0)

path = Path(sys.argv[1])
if not path.exists():
    sys.exit(0)
try:
    data = tomllib.loads(path.read_text())
except Exception:
    sys.exit(0)
url = data.get("model_providers", {}).get("odin", {}).get("base_url", "")
if url.endswith("/openai/v1"):
    url = url[: -len("/openai/v1")]
print(url)
PY
}

update_provider_config() {
  local provider="$1" model="$2" base_url="${3:-}"
  mkdir -p "$CODEX_DIR"
  local tmp
  tmp=$(mktemp "$CODEX_DIR/.config.XXXXXX")
  python3 - "$CONFIG" "$tmp" "$provider" "$model" "$base_url" <<'PY'
import json
import re
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
tmp_path = Path(sys.argv[2])
provider = sys.argv[3]
model = sys.argv[4]
base_url = sys.argv[5]

def toml_string(value: str) -> str:
    return json.dumps(value)

def normalize_odin_base(url: str) -> str:
    value = url.rstrip("/")
    if value.endswith("/responses"):
        value = value[: -len("/responses")]
    if value.endswith("/openai/v1"):
        return value
    return f"{value}/openai/v1"

text = config_path.read_text() if config_path.exists() else ""
lines = text.splitlines()

# Replace any existing Odin provider block only when writing a fresh Odin block.
# Switching back to OpenAI leaves the block in place so the next Odin switch can
# reuse its base URL without requiring the environment again.
without_odin = []
if provider == "odin":
    skip = False
    for line in lines:
        if re.match(r"\s*\[model_providers\.odin\]\s*(?:#.*)?$", line):
            skip = True
            continue
        if skip and re.match(r"\s*\[", line):
            skip = False
        if not skip:
            without_odin.append(line)
else:
    without_odin = lines

out = []
at_top = True
saw_model = False
saw_model_provider = False

def emit_missing_top_level() -> None:
    global saw_model, saw_model_provider
    if not saw_model:
        out.append(f"model = {toml_string(model)}")
        saw_model = True
    if provider == "odin" and not saw_model_provider:
        out.append('model_provider = "odin"')
        saw_model_provider = True

for line in without_odin:
    if at_top and re.match(r"\s*\[", line):
        emit_missing_top_level()
        at_top = False
        out.append(line)
        continue

    if at_top and re.match(r"\s*model\s*=", line):
        out.append(f"model = {toml_string(model)}")
        saw_model = True
        continue

    if at_top and re.match(r"\s*model_provider\s*=", line):
        if provider == "odin":
            out.append('model_provider = "odin"')
            saw_model_provider = True
        continue

    out.append(line)

if at_top:
    emit_missing_top_level()

if provider == "odin":
    if not base_url:
        raise SystemExit("missing Odin base URL")
    if out and out[-1] != "":
        out.append("")
    out.extend(
        [
            "[model_providers.odin]",
            'name = "Odin Gateway"',
            f"base_url = {toml_string(normalize_odin_base(base_url))}",
            'env_key = "ODIN_GATEWAY_TOKEN"',
            'wire_api = "responses"',
        ]
    )

tmp_path.write_text("\n".join(out).rstrip() + "\n")
PY
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG"
}

cmd_provider_status() {
  python3 - "$CONFIG" <<'PY'
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError as exc:
    raise SystemExit(f"tomllib unavailable: {exc}")

path = Path(sys.argv[1])
data = {}
if path.exists():
    data = tomllib.loads(path.read_text())

provider = data.get("model_provider") or "openai"
model = data.get("model") or "?"
odin = data.get("model_providers", {}).get("odin", {})
print(f"provider: {provider}")
print(f"model:    {model}")
if odin:
    print(f"odin:     {odin.get('base_url', '?')}")
PY
  local active; active=$(active_provider_name)
  [[ -n "$active" ]] && echo "slot:     $active"
  return 0
}

cmd_provider_use() {
  local provider="${1:-}"
  [[ -n "$provider" ]] || die "usage: codex-acct provider use {openai|odin}"
  shift || true

  local restart=1
  local model=""
  local base_url=""
  while (($#)); do
    case "$1" in
      --no-daemon-restart) restart=0; shift ;;
      --model)
        [[ -n "${2:-}" ]] || die "--model requires a value"
        model="$2"
        shift 2
        ;;
      --model=*)
        model="${1#--model=}"
        shift
        ;;
      --base-url)
        [[ -n "${2:-}" ]] || die "--base-url requires a value"
        base_url="$2"
        shift 2
        ;;
      --base-url=*)
        base_url="${1#--base-url=}"
        shift
        ;;
      *)
        die "unknown provider option: $1"
        ;;
    esac
  done

  case "$provider" in
    odin)
      local env_base_url="" env_model="" env_defaults="" env_file=""
      if [[ -z "$base_url" || -z "$model" ]]; then
        env_defaults=$(read_odin_env_defaults || true)
        if [[ -n "$env_defaults" ]]; then
          IFS=$'\t' read -r env_base_url env_model <<< "$env_defaults"
        fi
      fi
      model="${model:-${ODIN_GATEWAY_MODEL:-${env_model:-gpt-5.5}}}"
      base_url="${base_url:-${ODIN_GATEWAY_BASE_URL:-${env_base_url:-}}}"
      if [[ -z "$base_url" ]]; then
        base_url=$(current_odin_base_url)
      fi
      [[ -n "$base_url" ]] || die "Odin base URL required: set ODIN_GATEWAY_BASE_URL or pass --base-url"
      update_provider_config odin "$model" "$base_url"
      write_active_provider_name odin
      env_file=$(odin_env_file)
      if [[ -z "${ODIN_GATEWAY_TOKEN:-}" && -z "$env_file" ]]; then
        echo "note: ODIN_GATEWAY_TOKEN is not set in this shell; Codex runs need it at runtime." >&2
      fi
      (( restart )) && restart_daemon
      echo "provider now: odin  ($model)"
      ;;
    openai)
      model="${model:-${CODEX_ACCT_OPENAI_MODEL:-gpt-5.5}}"
      update_provider_config openai "$model" ""
      write_active_provider_name openai
      (( restart )) && restart_daemon
      echo "provider now: openai  ($model)"
      ;;
    *)
      die "unknown provider '$provider' (expected: openai or odin)"
      ;;
  esac
}

cmd_provider() {
  local action="${1:-status}"
  shift || true
  case "$action" in
    status|who) cmd_provider_status "$@" ;;
    use|switch) cmd_provider_use "$@" ;;
    *)
      die "usage: codex-acct provider {status|use openai|use odin}"
      ;;
  esac
}

cmd_who() {
  local provider; provider=$(config_provider)
  if [[ "$provider" == "odin" ]]; then
    cmd_provider_status
    return 0
  fi

  [[ -f "$AUTH" ]] || die "no $AUTH — run: codex login"
  IFS=$'\t' read -r email plan sub acct < <(decode_auth "$AUTH")
  echo "email:      ${email:-?}"
  echo "plan:       ${plan:-?}"
  echo "account_id: ${acct:-?}"
  local active; active=$(active_name)
  [[ -n "$active" ]] && echo "slot:       $active"
  local prim; prim=$(primary_name)
  if [[ -n "$prim" && -f "$ACCTS/$prim.json" ]]; then
    local psub; psub=$(decode_auth "$ACCTS/$prim.json" | cut -f3)
    if [[ "$psub" == "$sub" ]]; then
      echo "status:     active is PRIMARY ($prim) — macbook pairing intact"
    else
      echo "status:     NOT primary (primary=$prim) — macbook pairing may be broken until restored"
    fi
  fi
}

cmd_list() {
  local cur_sub; cur_sub=$(current_sub)
  local cur_provider; cur_provider=$(config_provider)
  local cur_model; cur_model=$(config_model)
  local prim; prim=$(primary_name)
  shopt -s nullglob
  local files=("$ACCTS"/*.json)
  printf '%-20s %-32s %-8s %s\n' "NAME" "EMAIL" "PLAN" "FLAGS"
  for f in "${files[@]}"; do
    local name; name=$(basename "$f" .json)
    IFS=$'\t' read -r email plan sub _acct < <(decode_auth "$f")
    local flags=""
    [[ "$cur_provider" != "odin" && "$sub" == "$cur_sub" && -n "$sub" ]] && flags+="active "
    [[ "$name" == "$prim" ]] && flags+="primary "
    printf '%-20s %-32s %-8s %s\n' "$name" "${email:-?}" "${plan:-?}" "$flags"
  done
  local odin_flags=""
  [[ "$cur_provider" == "odin" ]] && odin_flags+="active "
  printf '%-20s %-32s %-8s %s\n' "odin" "(provider)" "$cur_model" "$odin_flags"
}

require_name() {
  [[ -n "${1:-}" ]] || die "usage: codex-acct $2 <name>"
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "name must match [A-Za-z0-9_-]+"
}

cmd_save() {
  require_name "${1:-}" save
  local name="$1"
  reserved_provider_name "$name" && die "'$name' is reserved for provider switching"
  [[ -f "$AUTH" ]] || die "no $AUTH to save"
  local dest="$ACCTS/$name.json"
  if [[ -f "$dest" && "${2:-}" != "--force" ]]; then
    die "$dest exists — pass --force to overwrite"
  fi
  copy_auth_atomic "$AUTH" "$dest"
  IFS=$'\t' read -r email plan _sub _acct < <(decode_auth "$dest")
  # If this save matches the active auth, mark the slot active so future swaps refresh it.
  local cur_sub psub; cur_sub=$(current_sub); psub=$(decode_auth "$dest" | cut -f3)
  if [[ -n "$cur_sub" && "$cur_sub" == "$psub" ]]; then
    write_active_name "$name"
  fi
  echo "saved: $name  ($email, $plan)"
}

cmd_use() {
  local restart=1
  local args=()
  for a in "$@"; do
    case "$a" in
      --no-daemon-restart) restart=0 ;;
      *) args+=("$a") ;;
    esac
  done
  set -- "${args[@]}"

  require_name "${1:-}" use
  local name="$1"
  shift || true
  if reserved_provider_name "$name"; then
    local provider_args=("$name")
    (( restart == 0 )) && provider_args+=("--no-daemon-restart")
    provider_args+=("$@")
    cmd_provider_use "${provider_args[@]}"
    return
  fi

  local src="$ACCTS/$name.json"
  [[ -f "$src" ]] || die "no saved account '$name' (see: codex-acct list)"
  local prior_provider; prior_provider=$(config_provider)

  local prim; prim=$(primary_name)
  if [[ -n "$prim" && -f "$ACCTS/$prim.json" ]]; then
    local cur_sub psub; cur_sub=$(current_sub); psub=$(decode_auth "$ACCTS/$prim.json" | cut -f3)
    if [[ "$cur_sub" == "$psub" && "$name" != "$prim" ]]; then
      echo "note: leaving primary account ($prim) — macbook pairing will stop working until you restore it."
    fi
  fi

  # Refresh-token freshness: persist the LIVE auth.json back into its named slot before swapping.
  # auth.json rotates over time (refresh on use); snapshots can otherwise grow stale.
  if [[ -f "$AUTH" ]]; then
    sync_active_slot
    save_previous_snapshot
  fi

  copy_auth_atomic "$src" "$AUTH"

  write_active_name "$name"
  if [[ "$prior_provider" == "odin" ]]; then
    update_provider_config openai "${CODEX_ACCT_OPENAI_MODEL:-$(config_model)}" ""
    write_active_provider_name openai
  fi
  (( restart )) && restart_daemon
  IFS=$'\t' read -r email plan _sub _acct < <(decode_auth "$AUTH")
  echo "now using: $name  ($email, $plan)"
}

cmd_add() {
  local restart=1
  local args=()
  for a in "$@"; do
    case "$a" in
      --no-daemon-restart) restart=0 ;;
      *) args+=("$a") ;;
    esac
  done
  set -- "${args[@]}"

  require_name "${1:-}" add
  local name="$1"
  reserved_provider_name "$name" && die "'$name' is reserved for provider switching"
  local dest="$ACCTS/$name.json"
  [[ -f "$dest" ]] && die "$dest exists — pick a new name or rm it first"

  sync_active_slot
  save_previous_snapshot
  local held_auth=""
  if [[ -f "$AUTH" ]]; then
    held_auth=$(mktemp "$CODEX_DIR/.auth-held.XXXXXX")
    copy_auth_atomic "$AUTH" "$held_auth"
    rm -f "$AUTH"
  fi

  echo "Running 'codex login'..."
  if ! codex login; then
    if [[ -n "$held_auth" && -f "$held_auth" ]]; then
      copy_auth_atomic "$held_auth" "$AUTH"
      rm -f "$held_auth"
    fi
    die "codex login failed; restored previous auth"
  fi
  rm -f "$held_auth"
  [[ -f "$AUTH" ]] || die "login did not produce $AUTH"
  copy_auth_atomic "$AUTH" "$dest"
  write_active_name "$name"
  if [[ "$(config_provider)" == "odin" ]]; then
    update_provider_config openai "${CODEX_ACCT_OPENAI_MODEL:-$(config_model)}" ""
    write_active_provider_name openai
  fi
  (( restart )) && restart_daemon
  IFS=$'\t' read -r email plan _sub _acct < <(decode_auth "$dest")
  echo "added & active: $name  ($email, $plan)"
}

cmd_primary() {
  require_name "${1:-}" primary
  local name="$1"
  reserved_provider_name "$name" && die "'$name' is reserved for provider switching"
  [[ -f "$ACCTS/$name.json" ]] || die "no saved account '$name'"
  echo -n "$name" > "$PRIMARY_FILE"
  chmod 600 "$PRIMARY_FILE"
  echo "primary set to: $name"
}

cmd_restore() {
  local restart=1
  local args=()
  for a in "$@"; do
    case "$a" in
      --no-daemon-restart) restart=0 ;;
      *) args+=("$a") ;;
    esac
  done
  set -- "${args[@]}"

  local src="$ACCTS/$PREV_NAME.json"
  [[ -f "$src" ]] || die "no previous account snapshot to restore"
  local prior_provider; prior_provider=$(config_provider)
  # Save live state back to its named slot first (freshness)
  sync_active_slot
  copy_auth_atomic "$src" "$AUTH"
  # Try to figure out which named slot the restored auth corresponds to
  local rsub; rsub=$(current_sub)
  local matched=""
  shopt -s nullglob
  for f in "$ACCTS"/*.json; do
    local nm; nm=$(basename "$f" .json); [[ "$nm" == "$PREV_NAME" ]] && continue
    [[ "$(decode_auth "$f" | cut -f3)" == "$rsub" && -n "$rsub" ]] && { matched="$nm"; break; }
  done
  if [[ -n "$matched" ]]; then write_active_name "$matched"
  else rm -f "$ACTIVE_FILE"
  fi
  if [[ "$prior_provider" == "odin" ]]; then
    update_provider_config openai "${CODEX_ACCT_OPENAI_MODEL:-$(config_model)}" ""
    write_active_provider_name openai
  fi
  (( restart )) && restart_daemon
  IFS=$'\t' read -r email plan _sub _acct < <(decode_auth "$AUTH")
  echo "restored previous: ($email, $plan)${matched:+  [active slot: $matched]}"
}

cmd_sync() {
  sync_active_slot
  if [[ -n "$SYNCED_SLOT" ]]; then
    echo "synced: $SYNCED_SLOT"
  elif [[ -n "$SYNC_NOTE" ]]; then
    echo "synced: skipped ($SYNC_NOTE)"
  else
    echo "synced: no auth"
  fi
}

cmd_run_codex() {
  local rc=0
  local codex_bin
  codex_bin=$(real_codex_bin)
  with_lock sync_active_slot
  if [[ "$(config_provider)" == "odin" ]]; then
    load_odin_env_for_child
  fi
  "$codex_bin" "$@" || rc=$?
  with_lock sync_active_slot
  return "$rc"
}

# Write the managed wrapper at $CODEX_WRAPPER pointing at real binary $1.
# Atomic: temp file in the same directory, then mv — a concurrent `codex` sees
# either the old entry or the finished wrapper, never a half-written script.
write_managed_wrapper() {
  local real="$1" self tmp
  self=$(script_path)
  tmp=$(mktemp "$(dirname "$CODEX_WRAPPER")/.codex-acct-wrapper.XXXXXX")
  {
    echo '#!/usr/bin/env bash'
    echo '# codex-acct managed wrapper'
    echo 'set -euo pipefail'
    printf 'export CODEX_ACCT_REAL_CODEX=%s\n' "$(shell_quote "$real")"
    printf 'exec %s codex "$@"\n' "$(shell_quote "$self")"
  } > "$tmp"
  chmod 755 "$tmp"
  mv -f "$tmp" "$CODEX_WRAPPER"
}

# True when the wrapper path holds the stock symlink npm creates for the
# @openai/codex bin entry — the one shape (besides absence) repair may replace.
wrapper_is_npm_stock() {
  [[ -L "$CODEX_WRAPPER" ]] || return 1
  case "$(readlink "$CODEX_WRAPPER")" in
    */node_modules/@openai/codex/bin/codex.js) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_install_wrapper() {
  [[ $# -eq 0 ]] || die "usage: codex-acct install-wrapper"
  mkdir -p "$(dirname "$CODEX_WRAPPER")"
  local real
  real="$CODEX_REAL"

  if [[ "$CODEX_WRAPPER" == "$real" ]]; then
    die "wrapper path and real codex path must be different"
  fi

  if [[ -e "$CODEX_WRAPPER" || -L "$CODEX_WRAPPER" ]]; then
    if is_managed_codex_wrapper "$CODEX_WRAPPER"; then
      [[ -x "$real" ]] || die "managed wrapper exists but real codex is missing: $real"
    else
      [[ ! -e "$real" && ! -L "$real" ]] || die "$real already exists; refusing to overwrite it"
      mv "$CODEX_WRAPPER" "$real"
    fi
  else
    local found
    found=$(real_codex_bin)
    ln -s "$found" "$real"
  fi

  [[ -x "$real" ]] || die "real codex is not executable: $real"

  write_managed_wrapper "$real"
  echo "installed codex wrapper: $CODEX_WRAPPER -> codex-acct codex"
  echo "real codex: $real"
}

# Reconcile the wrapper after something (typically `npm install -g @openai/codex`,
# which npm's update path lets silently replace foreign files at the bin path)
# clobbered it. Conservative on purpose: only the two recognizable clobber shapes
# are repaired — the stock npm symlink and a missing file. Anything else at the
# wrapper path fails closed so an unknown tool's file is never destroyed.
# Idempotent and cheap when healthy; safe to call from the watcher every poll.
cmd_repair_wrapper() {
  local quiet=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --quiet|-q) quiet=1; shift ;;
      *) die "usage: codex-acct repair-wrapper [--quiet]" ;;
    esac
  done
  local real="$CODEX_REAL"

  if is_managed_codex_wrapper "$CODEX_WRAPPER"; then
    [[ -x "$real" ]] || die "wrapper is managed but real codex is missing: $real"
    (( quiet )) || echo "wrapper ok: $CODEX_WRAPPER"
    return 0
  fi

  if [[ -e "$CODEX_WRAPPER" || -L "$CODEX_WRAPPER" ]]; then
    wrapper_is_npm_stock \
      || die "refusing to repair: unexpected file at $CODEX_WRAPPER (not the managed wrapper or the stock npm symlink)"
  fi

  # Make the real slot valid before touching the wrapper path. A dangling real
  # symlink (package dir replaced mid-update) is dead weight — replace it.
  if [[ -L "$real" && ! -e "$real" ]]; then
    rm -f "$real"
  fi
  if [[ ! -e "$real" && ! -L "$real" ]]; then
    if wrapper_is_npm_stock; then
      mv "$CODEX_WRAPPER" "$real"
    else
      # Wrapper path is empty too; fall back to the npm package's bin script.
      local pkg_bin
      pkg_bin="$(npm_codex_bin)" || die "cannot repair: no real codex found (npm package missing?)"
      ln -s "$pkg_bin" "$real"
    fi
  fi
  [[ -x "$real" ]] || die "cannot repair: real codex is not executable: $real"

  write_managed_wrapper "$real"
  (( quiet )) || echo "repaired codex wrapper: $CODEX_WRAPPER -> codex-acct codex"
}

# Locate the npm-installed codex bin script without consulting PATH (the wrapper
# path itself may be the only PATH hit and could be anything mid-repair).
npm_codex_bin() {
  local prefix candidate
  prefix=$(npm prefix -g 2>/dev/null) || return 1
  candidate="$prefix/lib/node_modules/@openai/codex/bin/codex.js"
  [[ -e "$candidate" ]] || candidate="$prefix/node_modules/@openai/codex/bin/codex.js"
  [[ -e "$candidate" ]] || return 1
  echo "$candidate"
}

# Update the npm package, then immediately re-assert the wrapper npm just
# clobbered. The habit-friendly replacement for `npm install -g @openai/codex`.
cmd_update() {
  [[ $# -eq 0 ]] || die "usage: codex-acct update"
  npm install -g @openai/codex || die "npm install -g @openai/codex failed"
  cmd_repair_wrapper
}

cmd_uninstall_wrapper() {
  [[ $# -eq 0 ]] || die "usage: codex-acct uninstall-wrapper"
  [[ -e "$CODEX_WRAPPER" || -L "$CODEX_WRAPPER" ]] || die "codex wrapper not found: $CODEX_WRAPPER"
  is_managed_codex_wrapper "$CODEX_WRAPPER" || die "not a codex-acct managed wrapper: $CODEX_WRAPPER"
  [[ -e "$CODEX_REAL" || -L "$CODEX_REAL" ]] || die "real codex backup not found: $CODEX_REAL"
  mv -f "$CODEX_REAL" "$CODEX_WRAPPER"
  echo "restored real codex: $CODEX_WRAPPER"
}

cmd_rm() {
  require_name "${1:-}" rm
  local name="$1"
  reserved_provider_name "$name" && die "'$name' is a virtual provider slot and cannot be removed"
  local f="$ACCTS/$name.json"
  [[ -f "$f" ]] || die "no saved account '$name'"
  rm -f "$f"
  [[ "$(primary_name)" == "$name" ]] && rm -f "$PRIMARY_FILE"
  echo "removed: $name"
}

WATCH_PID_FILE="$CODEX_DIR/watch.pid"
WATCH_LOG_FILE="$CODEX_DIR/watch.log"

watch_running() {
  [[ -f "$WATCH_PID_FILE" ]] || return 1
  local pid; pid=$(cat "$WATCH_PID_FILE" 2>/dev/null || echo "")
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

cmd_watch() {
  local action="${1:-status}"
  case "$action" in
    start)
      if watch_running; then
        echo "already running (pid $(cat "$WATCH_PID_FILE"))"
        return 0
      fi
      local bin
      bin=$(command -v codex-acct-watch || true)
      [[ -n "$bin" ]] || die "codex-acct-watch not found on PATH"
      nohup "$bin" >>"$WATCH_LOG_FILE" 2>&1 &
      echo $! > "$WATCH_PID_FILE"
      chmod 600 "$WATCH_PID_FILE"
      echo "started (pid $(cat "$WATCH_PID_FILE"))"
      ;;
    stop)
      if ! watch_running; then
        rm -f "$WATCH_PID_FILE"
        echo "not running"
        return 0
      fi
      local pid; pid=$(cat "$WATCH_PID_FILE")
      kill "$pid" 2>/dev/null || true
      rm -f "$WATCH_PID_FILE"
      echo "stopped (pid $pid)"
      ;;
    status)
      if watch_running; then
        echo "running (pid $(cat "$WATCH_PID_FILE"))"
      else
        echo "not running"
      fi
      ;;
    *)
      die "usage: codex-acct watch {start|stop|status}"
      ;;
  esac
}

usage() {
  cat <<EOF
codex-acct — switch Codex (ChatGPT) accounts by swapping ~/.codex/auth.json

  codex-acct who                     show current account
  codex-acct list                    list saved accounts
  codex-acct save <name> [--force]   snapshot current auth.json as <name>
  codex-acct use  <name> [--no-daemon-restart]
                                     switch to saved <name> (atomic swap +
                                     restart of the codex app-server daemon so
                                     codex re-reads auth)
  codex-acct use  odin [--model MODEL] [--base-url URL]
                                     switch to the Odin Responses provider
  codex-acct add  <name> [--no-daemon-restart]
                                     run codex login, save result as <name>
                                     (also restarts the app-server daemon)
  codex-acct sync                    persist live auth.json into the active slot
  codex-acct codex [args...]         run codex, then save any rotated tokens on exit
  codex-acct install-wrapper         make plain 'codex' run through codex-acct
  codex-acct uninstall-wrapper       restore the original plain 'codex' launcher
  codex-acct repair-wrapper [--quiet]
                                     re-assert the managed wrapper after an npm
                                     codex update clobbered it (no-op when healthy;
                                     refuses to touch unrecognized files)
  codex-acct update                  npm install -g @openai/codex + repair-wrapper
  codex-acct provider status         show active model provider from config.toml
  codex-acct provider use odin [--base-url URL] [--model MODEL]
                                     explicit form of: use odin
  codex-acct provider use openai [--model MODEL]
                                     switch config.toml back to the default OpenAI provider
  codex-acct odin [--base-url URL]   shorthand for: provider use odin
  codex-acct openai                  shorthand for: provider use openai
  codex-acct primary <name>          mark <name> as the macbook-paired account
  codex-acct restore [--no-daemon-restart]
                                     swap back to the previous account
                                     (also restarts the app-server daemon)
  codex-acct rm   <name>             delete a saved account
  codex-acct watch {start|stop|status}
                                     background daemon that mirrors auth.json
                                     into the active slot on every change

Storage: $ACCTS  (mode 0600)
EOF
}

sub="${1:-}"; shift || true
case "$sub" in
  who) cmd_who "$@" ;;
  list|ls) cmd_list "$@" ;;
  save) with_lock cmd_save "$@" ;;
  use|switch) with_lock cmd_use "$@" ;;
  add|login) with_lock cmd_add "$@" ;;
  sync) with_lock cmd_sync "$@" ;;
  codex|run) cmd_run_codex "$@" ;;
  install-wrapper|install-codex-wrapper) cmd_install_wrapper "$@" ;;
  uninstall-wrapper|uninstall-codex-wrapper) cmd_uninstall_wrapper "$@" ;;
  repair-wrapper) with_lock cmd_repair_wrapper "$@" ;;
  update) with_lock cmd_update "$@" ;;
  provider) with_lock cmd_provider "$@" ;;
  odin) with_lock cmd_provider_use odin "$@" ;;
  openai) with_lock cmd_provider_use openai "$@" ;;
  primary) with_lock cmd_primary "$@" ;;
  restore) with_lock cmd_restore "$@" ;;
  rm|remove|delete) with_lock cmd_rm "$@" ;;
  watch) cmd_watch "$@" ;;
  ""|-h|--help|help) usage ;;
  *) cmd_run_codex "$sub" "$@" ;;
esac
